{
  "name": "emet-near",
  "version": "0.1.0",
  "private": true,
  "description": "Emet — Outcome-Verified Agent Budget & Cross-Chain Settlement Kernel on NEAR",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreatSage-dev/emet.git"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release",
    "test": "node --test packages/agent-gateway/tests/settlement.test.mjs",
    "serve:gateway": "node packages/agent-gateway/src/gateway_server.mjs",
    "demo:attack": "node packages/agent-gateway/src/demo-attack.mjs",
    "demo:quote": "node packages/agent-gateway/src/demo-quote.mjs",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "submit:preview": "node scripts/submit.mjs",
    "submit": "node scripts/submit.mjs --submit"
  },
  "keywords": [
    "near",
    "mpc",
    "chain-signatures",
    "near-intents",
    "ai-agents",
    "security"
  ],
  "license": "MIT"
}
